# Production Server & Security Environment Variables
PORT=5000
NODE_ENV=production

# JWT Secrets (Minimum 256-bit high-entropy strings)
JWT_ACCESS_SECRET=c8e9f5b2d1a34e6f8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a
JWT_REFRESH_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2

# JWT Expiration Configuration
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# Argon2 / Password Hashing Cost Parameters
ARGON_TIME_COST=3
ARGON_MEMORY_COST=65536
ARGON_PARALLELISM=4

# Rate Limiting & Account Lockout Thresholds
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
OTP_EXPIRY_MINUTES=3
MAX_OTP_VERIFY_ATTEMPTS=3

# CORS Allowed Origins (Must strictly specify allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://sutriva.com

# Cookie Security
COOKIE_SECRET=sutriva_cookie_sec_993821093481023812
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# Razorpay Payment Gateway Credentials (Sandbox / Production)
# Test Mode: Use rzp_test_... Key ID & Secret from Razorpay Dashboard -> Settings -> API Keys
# Production Mode: Use rzp_live_... Key ID & Secret
RAZORPAY_KEY_ID=rzp_test_1234567890abcdef
RAZORPAY_KEY_SECRET=abcdef1234567890ghijklmn
RAZORPAY_WEBHOOK_SECRET=whsec_sutriva_production_webhook_secret

# Google Maps Platform API Credentials (Optional: If omitted, Sutriva automatically uses real OpenStreetMap / Overpass / OSRM data)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here


